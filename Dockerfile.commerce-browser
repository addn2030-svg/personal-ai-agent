FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CHROME_BIN=/usr/bin/chromium

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium chromium-driver ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-commerce-browser.txt ./
RUN pip install --no-cache-dir -r requirements-commerce-browser.txt

COPY . .

CMD ["python3", "-u", "connectors/commerce_browser_provider.py"]
