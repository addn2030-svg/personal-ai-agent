# ============================================================================
# Hermes Agent — Railway Variables template
#
#   These values go in: Railway → Hermes service → Variables tab.
#   NEVER put real values in this file, in Git, in a Sheet, or in Supabase.
#   This file is documentation only — Railway injects the real values at runtime.
# ============================================================================

# ── LLM backend — choose ONE block ─────────────────────────────────────────

# Option 1 — OpenRouter (recommended: reliable, has free-tier models)
OPENROUTER_API_KEY=

# Option 2 — AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Option 3 — Free open-source model via an OpenAI-compatible endpoint
# (Ollama / vLLM / llama.cpp running on YOUR GPU — not on Railway)
# OPENAI_BASE_URL=
# OPENAI_API_KEY=dummy

# ── Messaging — choose one or both ─────────────────────────────────────────

# Telegram (token from @BotFather). Allowed users = your numeric Telegram ID,
# so strangers cannot talk to your agent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# WhatsApp (pairing via QR code shown in the Hermes dashboard/logs).
# Phone numbers without "+", e.g. 9665XXXXXXXX
# WHATSAPP_ENABLED=true
# WHATSAPP_ALLOWED_USERS=

# ── Supabase monitoring (server-side only) ──────────────────────────────────
# Project URL + secret key from: Supabase → Settings → API Keys.
# The service_role / secret key stays HERE (server) — never in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Webhook mode (Step 5B): the Edge Function endpoint + shared secret.
# HERMES_WEBHOOK_URL=https://<project-ref>.supabase.co/functions/v1/log-run
# HERMES_WEBHOOK_SECRET=

# ── Hermes runtime ──────────────────────────────────────────────────────────
# Persistent state home — must point at the mounted Railway volume.
HERMES_HOME=/data
