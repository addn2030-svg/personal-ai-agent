# بيانات تشغيل شخصية — لا تُرفع أبدًا (خصوصية)
data/state.json
data/audit.jsonl
data/backups/
# ذاكرة الوكيل التشغيلية (عاملة/عرضية/دلالية) — حالة شخصية runtime
data/memory/
data/.state.lock
data/inbox.csv
data/inbox-imported-*.csv
data/.manager-markers.json
reports/
uploads/
# Connector credentials / tokens — local only
secrets/
*.credentials.json
*.token.json
# الأنماط أعلاه لا تطابق اسمًا مجردًا: `credentials.json` (وهو بالضبط الاسم الذي
# تنزّله Google Cloud لعميل OAuth) كان يمر بلا تجاهل. تحقق: git check-ignore -v credentials.json
credentials.json
token.json
client_secret*.json
service-account*.json
.env
.env.*
# القالب فقط يُرفع — بلا أي قيمة حقيقية
!.env.example
# عام
__pycache__/
*.pyc
.DS_Store
# أدوات Railway IaC فقط — ليست جزءًا من زمن تشغيل التطبيق (التطبيق Python عبر Dockerfile)
# package-lock.json يُرفع عمدًا ليكون التثبيت في CI حتميًا
node_modules/
data/.telegram*
# مرحلة التشغيل التدريجي — حالة تشغيلية محلية (بالكامل خارج # تعليق السطر)
data/.rollout.json
data/.last-state-snapshot.json
data/rag-index.json
