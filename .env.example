# ============================================================================
# Abdulrahman AI OS — قالب متغيرات البيئة
#
#   cp .env.example .env     ثم املأ القيم المحلية فقط
#
# القواعد:
#   • لا ترفع `.env` إلى Git (مستثنى مسبقًا في .gitignore).
#   • لا تلصق أي مفتاح في محادثة أو تيليجرام.
#   • المتغيرات الحقيقية في البيئة تتقدّم دائمًا على هذا الملف.
#   • في الإنتاج (Railway) تُضبط المتغيرات في Service → Variables لا هنا.
# ============================================================================

# ── Supabase (نسخ الحالة خارج الخادم) ───────────────────────────────────────
# Project URL من: المشروع → Connect  أو  Settings → API Keys
SUPABASE_URL=
# publishable / anon key — قراءة فقط (آمن للنشر في المتصفح)
SUPABASE_ANON_KEY=
# secret / service_role key — يقرأ ويكتب كل شيء. خادم فقط: لا متصفح ولا Git ولا محادثة.
SUPABASE_SERVICE_ROLE_KEY=
# الكتابة مغلقة افتراضيًا؛ فعّلها بعد ضبط المفتاح السري
SUPABASE_WRITE_ENABLED=0
# اختياري
# SUPABASE_STATE_TABLE=state_snapshots
# SUPABASE_SCHEMA=public
# SUPABASE_TIMEOUT_SECONDS=20

# ── مرآة المهام (استعلام مهامك بـSQL ومن الجوال) ────────────────────────────
# الاتجاه واحد: state.json ← tasks_mirror. لا تكتب في الجدول يدويًا.
# SUPABASE_TASKS_TABLE=tasks_mirror
# SUPABASE_TASKS_OWNER=            # افتراضيًا من data/.telegram-owner
# ── مضيف بلا قرص دائم (Render/Koyeb المجانيان) ──────────────────────────────
# بلا قرص، تُفقد data/state.json عند كل إيقاف ⇒ اجعل Supabase هو القرص:
# AI_OS_STATE_RESTORE_ON_BOOT=1   # استعد آخر نسخة عند الإقلاع إن فُقدت الحالة
# AI_OS_STATE_PERSIST=1           # ادفع كل تغيير (دفع تفاضلي) + دفع عند SIGTERM
# AI_OS_STATE_PERSIST_SECONDS=120 # الفاصل (الحد الأدنى 30)
# AI_OS_STATE_RESTORE_FORCE=1     # استعادة قسرية (للتصحيح اليدوي فقط)

# ── الدماغ الدائم: الذاكرة خارج الخادم (connectors/brain.py) ────────────────
# يحل مشكلة مختلفة عن استمرارية الحالة: data/memory/*.jsonl ليست داخل
# state.json، فلا تشملها النسخ الموقّعة. بلا هذه الطبقة تُفقد ذاكرة الوكيل
# الطويلة (الحلقات والحقائق) عند كل إيقاف على مضيف بلا قرص.
#   الإعداد لمرة واحدة: Supabase → SQL Editor → شغّل supabase/03_brain_memory.sql
#   والفحص:  python3 -m connectors.brain --status   |   --live   |   --import
# الثلاثة مغلقة افتراضيًا: لا شيء يُرسل إلى السحابة لمجرد وجود المفاتيح.
# BRAIN_ENABLED=1            # المفتاح الرئيس (قراءة/كتابة شبكية)
# BRAIN_RECALL_ENABLED=1     # حقن الذاكرة المسترجَعة في سياق الردود
# BRAIN_WRITE_ENABLED=1      # مرآة الكتابات المحلية (يحتاج المفتاح السري + SUPABASE_WRITE_ENABLED=1)
# BRAIN_RECALL_ITEMS=6       # عدد عناصر الاسترجاع المحقونة في السياق
# BRAIN_RECALL_CHARS=3000    # أقصى طول لكتلة الاسترجاع في السياق
# BRAIN_RECALL_TIMEOUT_SECONDS=6   # مهلة أقصر من مهلة التخزين: الرد لا ينتظر Supabase
# BRAIN_RECALL_FAILURES=3          # إخفاقات متتالية قبل فتح قاطع الدائرة
# BRAIN_RECALL_COOLDOWN_SECONDS=120 # مدة التخطّي بعد فتحه (يعود تلقائيًا)
# ملاحظة: المحتوى السريري (clinical_private) لا يُرسل إلى Supabase إطلاقًا.
# البيانات الحساسة تبقى في الملف المحلي، والمفتاح السري يبقى على الخادم.

# دفعة يومية تلقائية (نسخة كاملة + مزامنة المرآة) داخل حلقة المدير:
# SUPABASE_BACKUP_SCHEDULE_ENABLED=0
# SUPABASE_BACKUP_HOUR=6           # بتوقيت MANAGER_TIMEZONE (الرياض افتراضيًا)

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Google (حساب خدمة واحد يخدم Sheets/Drive/Docs/Calendar) ────────────────
# يقبل: JSON مباشر، base64، أو مسار ملف *.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
CLINICAL_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DOCS_DOCUMENT_ID=
GOOGLE_CALENDAR_ID=

# ── GitHub ──────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
AI_OS_GITHUB_REPO=addn2030-svg/personal-ai-agent

# ── نماذج اللغة ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=google/gemini-3.7-flash
KIMI_API_KEY=
AI_MODEL_PROVIDER=gemini

# ── النشر الاجتماعي ─────────────────────────────────────────────────────────
BUFFER_API_KEY=

# ── البحث عن فيديو (اختياري — يعمل بـDuckDuckGo بلا مفتاح) ──────────────────
YOUTUBE_API_KEY=

# ── المسارات والتشغيل ───────────────────────────────────────────────────────
# مجلد الحالة والتدقيق (على Railway: /data مع Volume)
AI_OS_DATA_DIR=
MANAGER_TIMEZONE=Asia/Riyadh

# ── المدفوعات (تتطلب تفعيلًا صريحًا — راجع docs/v1.1-money-threshold.md) ────
PAYMENT_GATEWAY_WEBHOOK_URL=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
MONEY_AUTOPAY_ENABLED=0
MONEY_AUTOPAY_ACK=
